# Runtime
AUTH_ENABLED=true
PORT=8080
HOST_PORT=8083
CONTAINER_PORT=8080
POSTGRES_HOST=huff-postgres
POSTGRES_PORT=5432
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_HOST_PORT=5432
POSTGRES_DB=huff_wordle
POSTGRES_USER=huff
POSTGRES_PASSWORD=change-me
GAME_TIMEZONE=Europe/Rome
WORDLE_WORD_SEED=huff-it-wordle
COOKIE_SECURE=true
OIDC_SESSION_AGE_EXTENSION=30D
OIDC_REFRESH_EXPIRED=true
OIDC_REFRESH_TOKEN_TIME_SKEW=5M
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@hexaquot.it
PUSH_NEW_GAME_CRON=0 2 0 * * ?
PUSH_DAILY_REMINDER_CRON=0 0 23 * * ?

# Docker deploy
IMAGE_NAME=huff-italian-wordle
CONTAINER_NAME=huff-wordle
DATA_DIR=/root/huff/data
DOCKER_NETWORK=huff-wordle
POSTGRES_CONTAINER_NAME=huff-postgres
POSTGRES_DATA_DIR=/root/huff/data/postgres
POSTGRES_IMAGE=postgres:16-alpine

# Google OAuth, used only when AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
