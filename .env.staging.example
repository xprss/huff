# Staging runtime
AUTH_ENABLED=true
PORT=8080
HOST_PORT=8084
CONTAINER_PORT=8080
POSTGRES_HOST=huff-postgres-staging
POSTGRES_PORT=5432
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_HOST_PORT=
POSTGRES_DB=huff_hexaquot_staging
POSTGRES_USER=huff_staging
POSTGRES_PASSWORD=change-me
GAME_TIMEZONE=Europe/Rome
COOKIE_SECURE=true
OIDC_SESSION_AGE_EXTENSION=30D
OIDC_REFRESH_EXPIRED=true
OIDC_REFRESH_TOKEN_TIME_SKEW=5M
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@staging.hexaquot.it
PUSH_NEW_GAME_CRON=0 31 0 * * ?
PUSH_DAILY_REMINDER_CRON=0 0 23 * * ?
HEXASKY_LAUNCH=true

# Private game statistics agent (replace each value with staging credentials)
OPENAI_API_KEY=
GAME_STATS_AGENT_TOKEN=replace-with-a-long-random-secret
POSTGRES_MCP_USER=huff_stats_agent
POSTGRES_MCP_PASSWORD=replace-with-a-separate-read-only-database-password
POSTGRES_MCP_DATABASE=huff_hexaquot_staging
POSTGRES_MCP_HOST=huff-postgres-staging
POSTGRES_MCP_PORT=5432
GAME_STATS_AGENT_DB_URL=file:./data/mastra.db

# Staging Docker deploy
IMAGE_NAME=huff-italian-hexaquot-staging
CONTAINER_NAME=huff-hexaquot-staging
DATA_DIR=/var/lib/jenkins/huff/data/staging
DOCKER_NETWORK=huff-hexaquot-staging
POSTGRES_CONTAINER_NAME=huff-postgres-staging
POSTGRES_DATA_DIR=/var/lib/jenkins/huff/data/staging/postgres
POSTGRES_IMAGE=postgres:16-alpine

# Google OAuth, used only when AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
